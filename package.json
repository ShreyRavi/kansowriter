{
  "name": "kansowriter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens && tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4317 --strictPort",
    "tokens": "tsx scripts/gen-tokens.ts",
    "tokens:check": "tsx scripts/gen-tokens.ts --check",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "csp:check": "tsx scripts/check-csp.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "measure:letters": "tsx scripts/measure-letters.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/markdown": "^1.8.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
